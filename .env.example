# =====================================================================
# LinH Pocket 环境变量示例
#
# 用法：
#   本地开发：复制本文件为 .env.local，按需填写后重启 npm run dev
#             （.env / .env.local 已在 .gitignore 中，不会被提交）
#   Vercel / Netlify：在项目 Settings → Environment Variables 中逐项添加，
#             改完变量需要重新部署才会生效。
#
# 约定：
#   1. 除 NEXT_PUBLIC_SELF_HOSTED_MODE 外，其余全部【可选】。
#      不填时对应云端功能自动隐藏或返回友好提示，应用不会白屏/报错，
#      本地单机功能（桌面、聊天、日记、游戏等）完全不受影响。
#   2. NEXT_PUBLIC_ 开头的变量会被打包进浏览器、任何人可见，
#      只能放 anon key / 公开地址，绝不能放 service_role 密钥。
#   3. 请一律填写你自己的项目密钥，不要使用他人的实例。
# =====================================================================


# ── 0. 部署模式（自部署【必填】，也是唯一必填项）────────────────────
# true = 单机模式：跳过作者官方账号/激活码系统，使用本地账号直接进入，
#        不需要任何 Supabase 即可使用全部本地功能（个人自部署推荐）。
# false = 启用账号门禁，需要再配齐下面第 1 组的主库变量与 ACCOUNT_GATE_SECRET。
# 作者自己的官方链接版不要设置这个变量。
NEXT_PUBLIC_SELF_HOSTED_MODE=true


# ── 1. 主 Supabase 项目（账号与所有云端功能共用）【可选】────────────
# 启用自己的云端功能时填写。需要先在 Supabase SQL Editor 执行
# docs/supabase-all-in-one.sql（或 docs/*.sql 中对应功能的建表脚本）。
# 不填时：账号登录、应用市场、便签墙云端、游戏大厅、黑市、审核后台、
# 推送桥等云端接口统一返回「未配置」的友好提示，功能入口自动隐藏。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 兼容别名（旧部署沿用，不必新填）：
#   SUPABASE_SECRET_KEY      等价于 SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_ANON_KEY        等价于 NEXT_PUBLIC_SUPABASE_ANON_KEY 的服务端读法

# 账号门禁 cookie 签名密钥【可选】：启用账号系统（上面第 1 组）时建议设置为
# 随机长字符串（例如 openssl rand -hex 32）。不填时自动回退使用
# SUPABASE_SERVICE_ROLE_KEY 作为签名密钥；两者都没有则门禁 cookie 不签发。
ACCOUNT_GATE_SECRET=


# ── 2. 独家特调专用的独立 Supabase 项目【可选】─────────────────────
# 特调（酒材页 / 配方页）的表、RPC 与全部读写只认这两个变量，
# 【刻意不回退】到上面的主库；不填就等于特调云端未开张（大厅显示未配置）。
# 需要先在这个项目的 SQL Editor 执行 docs/mixology-supabase.sql。
MIXOLOGY_SUPABASE_URL=
MIXOLOGY_SUPABASE_SERVICE_ROLE_KEY=


# ── 3. 浏览器直连 Supabase 的公开变量【可选】──────────────────────
# 注意 NEXT_PUBLIC_* 会公开到浏览器，这里只能放 anon/publishable key，
# 不要放 service_role。需要先执行 docs/online-play-supabase.sql 等脚本。
# 不填时：便签墙实时刷新退化为手动刷新，多人联机入口隐藏。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 新版 Supabase 控制台里 anon key 可能叫 publishable key，填这个名字也可以；
# 代码里 NEXT_PUBLIC_SUPABASE_ANON_KEY 优先，其次读它。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ── 4. 后台管理密钥【可选】────────────────────────────────────────
# 成年审核 / 激活码后台（/verify/admin）的管理密钥。
# 不填时后台一律返回 401（fail-closed），不影响前台。
VERIFY_ADMIN_KEY=
# 应用市场审核后台密钥。不填时自动回退使用 VERIFY_ADMIN_KEY。
APP_MARKET_ADMIN_KEY=


# ── 5. 生图与图床【可选】──────────────────────────────────────────
# 通用生图代理地址（自建 Cloudflare Worker 等）。配置后「服务端中转」模式
# 改走该代理（可绕过平台函数 60s 流式超时）；留空 = 关闭，沿用默认心跳流式路由。
NEXT_PUBLIC_IMAGE_GEN_PROXY_URL=
# ImgBB 服务端兜底 key。一般不用填——用户可在生图/图床设置里自行填写；
# 两者都没有时上传接口返回「缺少 ImgBB API Key」提示，不影响其他功能。
IMGBB_API_KEY=


# ── 6. 3D 世界搭建（Tripo）【可选】────────────────────────────────
# 服务端兜底 key。一般不用填——用户在「筑境 / 世界搭建」界面填写自己的 key；
# 服务端与用户 key 都缺失时，生成接口返回「缺少 API Key」提示。
TRIPO_API_KEY=


# ── 7. 在线音乐【可选】────────────────────────────────────────────
# 网易云音乐 API（NeteaseCloudMusicApi 兼容实例）的默认地址。
# 留空时在线音乐功能自动隐藏（仅保留本地音乐），用户也可在音乐 APP 设置里
# 自行填写。请部署你自己的实例，不要使用他人的。
NEXT_PUBLIC_DEFAULT_NETEASE_API_BASE=
# 仅当你更换过默认音乐 API 地址时需要：旧地址填这里（逗号分隔），
# 老用户浏览器里存的旧地址会自动迁移到当前默认。
NEXT_PUBLIC_LEGACY_NETEASE_API_BASES=
# 可选：转发给网易云 API 时附带的 realIP（大陆 IP 可减少风控），不填用内置默认值。
NEXT_PUBLIC_NETEASE_REAL_IP=


# ── 8. 微信助手网络代理【可选】────────────────────────────────────
# 当服务部署在无法直连 ilinkai.weixin.qq.com 的网络环境时，
# 填一个 HTTP 代理地址（如 http://user:pass@host:port）；留空则直连。
WEIXIN_PROXY=


# ── 9. 现实桥「邮件自动执行」实验通道【可选】──────────────────────
# 先在 Resend 验证自己的发信域名，再配置 API Key 和该域名下的发件地址。
# 三者任一缺失，现实桥里的邮件通道自动显示「尚未配置」，不影响其他桥接方式。
RESEND_API_KEY=
REALITY_BRIDGE_EMAIL_FROM="Float Reality Bridge <bridge@your-domain.example>"
# 邮件验证码 / 回执签名密钥，建议使用独立随机长字符串；
# 不填时回退使用 RESEND_API_KEY 作为签名密钥。
SHORTCUT_EMAIL_VERIFICATION_SECRET=
